# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# SOCKS5-туннель к api.telegram.org (Коренёво -> NL VPS): для Коренёво — socks5://127.0.0.1:1082
# TELEGRAM_PROXY=socks5://127.0.0.1:1082

# --- STT: AssemblyAI (v1.0.0) ---
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com
# Стабильный маршрут к AssemblyAI через NL VPS (домашний интернет к CDN нестабилен):
# ASSEMBLYAI_PROXY=socks5://127.0.0.1:1082
# Резервный провайдер (v1.3.0): STT_PROVIDER=assemblyai|speechkit
STT_PROVIDER=assemblyai
# SPEECHKIT_FOLDER_ID=
# SPEECHKIT_API_KEY=

# --- LLM: DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- Оплата (v1.1.0): stars | yookassa ---
PAYMENT_PROVIDER=stars

# --- Приложение ---
MAX_FILE_MB=20
RETENTION_DAYS=7
LANGUAGE_CODE=ru
DB_PATH=data/secretary.db
DATA_DIR=data
API_HOST=0.0.0.0
API_PORT=8000

# Админ-панель бота: твой TG id (узнать: @userinfobot), через запятую
# ADMIN_TG_IDS=

# Личный инструмент: конспекты пар/лекций (вместо «решений/задач» — учебные поля)
# STUDY_MODE=true